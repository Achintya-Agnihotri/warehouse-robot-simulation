<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 
 <!-- Robot dimensions -->
    <xacro:property name="base_length" value="0.5"/>
    <xacro:property name="base_width" value="0.3"/>
    <xacro:property name="base_height" value="0.2"/>

    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_width" value="0.05"/>

    <xacro:property name="caster_radius" value="0.05"/>

   

    <!-- Base Footprint -->
    <link name="base_footprint"/>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2 + wheel_radius}" rpy="0 0 0"/>
            <material name="base_link_material"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2 + wheel_radius}" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia
            m="2.0"
            x="${base_length}"
            y="${base_width}"
            z="${base_height}"
            o_xyz="0 0 ${base_height/2 + wheel_radius}"
            o_rpy="0 0 0"/>
    </link>

    <!-- Wheel Macro-->
    <xacro:macro name="wheel" params="prefix">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="wheel_material"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            </collision>
            <xacro:cylinder_inertia
                m="0.5"
                r="${wheel_radius}"
                l="${wheel_width}"
                o_xyz="0 0 0"
                o_rpy="${pi/2.0} 0 0"/>
        </link>
            
        </xacro:macro>
    <!-- Left Wheel -->
    <xacro:wheel prefix="left"/>
 

    <!-- Right Wheel -->
    <xacro:wheel prefix="right"/>


    <!-- Caster Wheel -->
    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="wheel_material"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
            <xacro:sphere_inertia
        m="0.2"
        r="${caster_radius}"
        o_xyz="0 0 0"
        o_rpy="0 0 0"/>
    </link>

    <!-- Base Footprint Joint -->
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0"/>
    </joint>

    <!-- Left Wheel Joint -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${-base_length/2 + wheel_radius} ${base_width/2 + wheel_width/2} ${wheel_radius}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Right Wheel Joint -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${-base_length/2 + wheel_radius} ${-base_width/2 - wheel_width/2} ${wheel_radius}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Caster Joint -->
    <joint name="caster_base" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${base_length/2 - caster_radius} 0 ${caster_radius}" rpy="0 0 0"/>
    </joint>
</robot>